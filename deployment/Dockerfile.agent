# LiveKit interview transcription agent — small dedicated image so its
# livekit-agents/openai deps never collide with the backend's pins.
# Build context is backend/ (NOT repo root — the root has no .dockerignore, so
# a root context ships frontend/node_modules and fills /var on APPQA):
#   docker build -f deployment/Dockerfile.agent -t interview-agent:latest backend/
FROM python:3.11-slim

WORKDIR /app
COPY agent-requirements.txt .
RUN pip install --no-cache-dir -r agent-requirements.txt

COPY agent.py .

CMD ["python", "agent.py"]
